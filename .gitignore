# Timestamped backups (driftwm's own auto-backup-on-save, and mine from this
# session) — git is the history now, these are just noise.
*.bak*

# Per-machine markers: the commit last applied by update.sh/install.sh, and
# the boot_id .zshrc last ran the update check on (so it only asks once per
# boot, not once per terminal). Not shared state — never commit these.
.installed_version
.last_checked_boot

# Notes widget's scratch content, weather's location override, clock's
# 12h/24h choice — personal, not part of the rice.
.config/driftwm/quickshell/notes.txt
.config/driftwm/quickshell/weather_location.txt
.config/driftwm/quickshell/clock_format.txt
__pycache__/
