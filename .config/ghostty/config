# ~/.config/ghostty/config
# Replaces foot as the default terminal (mod+Return in driftwm/config.toml).
# Colors live in ./colors, regenerated per-wallpaper (see
# ~/.config/driftwm/scripts/apply_theme_colors.py).

config-file = colors

font-family = Monocraft
font-size = 11

window-padding-x = 10
window-padding-y = 10
window-decoration = false
confirm-close-surface = false

cursor-style = bar

mouse-hide-while-typing = true

# Background transparency (matches alpha=0.85 in foot.ini/kitty.conf).
background-opacity = 0.85

# ~10k lines equivalent (foot's scrollback.lines=10000).
scrollback-limit = 10485760
