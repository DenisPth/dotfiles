{
  "cli_default_open_behavior": "existing_window",
  "theme": "Dark Sea",
  "buffer_font_family": "Monocraft",
  "ui_font_family": "Monocraft",
  "terminal": {
    "font_family": "Monocraft"
  },
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dark Sea",
  "author": "you",
  "themes": [
    {
      "name": "Dark Sea",
      "appearance": "dark",
      "style": {
        "border": "#4b5560ff",
        "border.variant": "#3a424dff",
        "border.focused": "#7089a0ff",
        "border.selected": "#7089a0ff",
        "border.transparent": "#00000000",
        "border.disabled": "#3a424dff",

        "elevated_surface.background": "#333b45ff",
        "surface.background": "#2b323cff",
        "background": "#2b323cff",

        "element.background": "#333b45ff",
        "element.hover": "#3a424dff",
        "element.active": "#4b5560ff",
        "element.selected": "#3a424dff",
        "element.disabled": "#2b323cff",

        "drop_target.background": "#7089a033",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#3a424dff",
        "ghost_element.active": "#4b5560ff",
        "ghost_element.selected": "#3a424dff",

        "text": "#c9c4abff",
        "text.muted": "#8f8a72ff",
        "text.placeholder": "#6a6a5eff",
        "text.disabled": "#6a6a5eff",
        "text.accent": "#7089a0ff",

        "icon": "#c9c4abff",
        "icon.muted": "#8f8a72ff",
        "icon.disabled": "#6a6a5eff",
        "icon.accent": "#7089a0ff",

        "status_bar.background": "#2b323cff",
        "title_bar.background": "#2b323cff",
        "toolbar.background": "#2b323cff",
        "tab_bar.background": "#2b323cff",
        "tab.inactive_background": "#2b323cff",
        "tab.active_background": "#333b45ff",

        "editor.background": "#2b323cff",
        "editor.foreground": "#c9c4abff",
        "editor.gutter.background": "#2b323cff",
        "editor.line_number": "#4b5560ff",
        "editor.active_line_number": "#c9c4abff",
        "editor.active_line.background": "#333b4580",
        "editor.highlighted_line.background": "#333b45ff",
        "editor.wrap_guide": "#4b556040",
        "editor.document_highlight.read_background": "#4b556060",
        "editor.document_highlight.write_background": "#7089a040",

        "terminal.background": "#2b323cff",
        "terminal.foreground": "#c9c4abff",
        "terminal.ansi.black": "#2b323cff",
        "terminal.ansi.red": "#b5665fff",
        "terminal.ansi.green": "#8a9a7cff",
        "terminal.ansi.yellow": "#c9b98aff",
        "terminal.ansi.blue": "#7089a0ff",
        "terminal.ansi.magenta": "#9a8aa0ff",
        "terminal.ansi.cyan": "#7fa6a0ff",
        "terminal.ansi.white": "#c9c4abff",
        "terminal.ansi.bright_black": "#4b5560ff",
        "terminal.ansi.bright_red": "#c77a72ff",
        "terminal.ansi.bright_green": "#9dad8fff",
        "terminal.ansi.bright_yellow": "#dcccA0ff",
        "terminal.ansi.bright_blue": "#87a0b8ff",
        "terminal.ansi.bright_magenta": "#ac9cb3ff",
        "terminal.ansi.bright_cyan": "#93bab4ff",
        "terminal.ansi.bright_white": "#e2ddc4ff",

        "conflict": "#c9b98aff",
        "created": "#8a9a7cff",
        "deleted": "#b5665fff",
        "error": "#b5665fff",
        "hint": "#7fa6a0ff",
        "info": "#7089a0ff",
        "modified": "#c9b98aff",
        "success": "#8a9a7cff",
        "warning": "#c9b98aff",

        "scrollbar.thumb.background": "#4b556080",
        "scrollbar.thumb.hover_background": "#7089a080",
        "scrollbar.track.background": "#00000000",

        "syntax": {
          "comment": { "color": "#8f8a72ff", "font_style": "italic" },
          "string": { "color": "#8a9a7cff" },
          "number": { "color": "#9a8aa0ff" },
          "boolean": { "color": "#9a8aa0ff" },
          "constant": { "color": "#e2ddc4ff" },
          "keyword": { "color": "#7089a0ff", "font_weight": 700 },
          "function": { "color": "#7089a0ff" },
          "type": { "color": "#c9b98aff" },
          "property": { "color": "#c9c4abff" },
          "variable": { "color": "#c9c4abff" },
          "operator": { "color": "#c9c4abff" },
          "punctuation": { "color": "#8f8a72ff" },
          "tag": { "color": "#7089a0ff" },
          "attribute": { "color": "#c9b98aff" },
          "title": { "color": "#e2ddc4ff", "font_weight": 700 },
          "emphasis": { "color": "#c9b98aff", "font_style": "italic" }
        }
      }
    }
  ]
}
