{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 38,
    // driftwm — не Hyprland: у него нет дискретных workspace'ов (бесконечный
    // канвас с камерой/зумом), поэтому вместо hyprland/workspaces и
    // hyprland/window (которые тут молча ничего не показывали бы — нет
    // hyprland-сокета) берём заголовок активного окна через нативный IPC
    // driftwm (см. scripts/driftwm-window.sh).
    "modules-left": ["custom/window", "mpris"],
    "modules-center": ["clock"],
    "modules-right": ["custom/weather", "network", "bluetooth", "pulseaudio", "custom/power-profile", "battery", "tray"],

    "custom/window": {
        "exec": "~/.config/waybar/scripts/driftwm-window.sh",
        "format": "{}",
        "max-length": 40,
        "tooltip": false
    },

    "mpris": {
        "format": "♫",
        "format-paused": "♫",
        "on-click": "qs -p ~/.config/driftwm/quickshell ipc call player toggle",
        "on-click-middle": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{artist} - {title}\nклик — открыть/закрыть плеер, средняя кнопка — пауза, скролл — след./пред. трек"
    },

    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 1800,
        "tooltip": true
    },

    "clock": {
        "format": "{:%H:%M  |  %A, %b %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip-format": "клик — pavucontrol, средняя кнопка — mute, скролл — громкость"
    },

    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "{ifname}",
        "format-disconnected": "Disconnected"
    },

    "bluetooth": {
        "format": "{status}",
        "format-disabled": "",
        "format-connected": "{num_connections}"
    },

    "custom/power-profile": {
        "exec": "~/.config/waybar/scripts/power_profile.sh",
        "on-click": "~/.config/waybar/scripts/power_profile.sh --cycle",
        "interval": 5,
        "tooltip": true,
        "tooltip-format": "клик — сменить профиль питания"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-charging": "{capacity}%",
        "format-plugged": "{capacity}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
