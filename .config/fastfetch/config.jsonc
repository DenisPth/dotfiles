// ~/.config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // kitty graphics protocol — ghostty (the default terminal) speaks
        // that, not sixel (leftover from when foot was the terminal).
        "type": "kitty",
        "source": "~/.config/fastfetch/logo.png",
        "width": 32,
        "height": 8,
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " -> ",
        "color": {
            "keys": "38;2;112;137;160",
            "title": "38;2;201;196;171",
            "output": "38;2;201;196;171",
            "separator": "38;2;75;85;96"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "break",
        "colors"
    ]
}
