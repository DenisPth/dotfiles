# Regenerated by apply_theme_colors.py on every wallpaper switch.
# screenshots: swaylock-effects grabs the actual desktop frame instead of a
# flat color — driftwm's shader wallpaper can't animate here (swaylock has
# no shader support at all), but a blurred freeze-frame of it beats a plain
# fill. Needs the swaylock-effects package, not plain swaylock — it's the
# only fork that understands effect-blur/screenshots/clock at all.
screenshots
effect-blur=7x5
effect-vignette=0.5:0.5
fade-in=0.2
clock
timestr=%H:%M
datestr=%A, %e %B

# Плоский цвет — запасной вариант, если screenshots не сработает (снимок
# делает сам swaylock-effects, база на случай сбоя).
color=2a3841

font=Sans
font-size=24

inside-color=2a3841aa
inside-clear-color=394149aa
inside-ver-color=97d6ffaa
inside-wrong-color=b5665faa

indicator-radius=100
indicator-thickness=10

line-use-label=true
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

ring-color=5a636aff
ring-clear-color=7fa6a0ff
ring-ver-color=8a9a7cff
ring-wrong-color=b5665fff

key-hl-color=e3e7ebff
bs-hl-color=b5665fff

text-color=e3e7ebff
text-clear-color=e3e7ebff
text-ver-color=2a3841ff
text-wrong-color=2a3841ff
